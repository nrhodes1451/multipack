{
  "name": "multipack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:mapping": "tsx --tsconfig tsconfig.app.json scripts/generate-mapping.ts",
