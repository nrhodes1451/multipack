    "export:mpc": "tsx --tsconfig tsconfig.app.json scripts/export-mpc.ts",
    "generate:readme-images": "tsx --tsconfig tsconfig.app.json scripts/readme-images.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-condensed": "^5.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.18",
    "wawoff2": "^2.0.1"
